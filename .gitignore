/target/
/target-*/

# Deterministic benchmark corpora, runs, and rendered reports.
/target/bench/
/bench/rarpar-bench/.cache/
# Operator-specific benchmark host inventory; it may reference private SSH keys.
/bench/rarpar-bench/config/hosts.local.json
# Operator-private benchmark fleet configuration; it names private hosts, SSH
# key paths, and askpass helper locations. Start from bench/fleet.example.toml.
# Every fleet*.toml variant (per-pass configs like fleet-perf-rebuy.toml) is
# ignored; only the example is tracked.
/bench/fleet*.toml
!/bench/fleet.example.toml

# Test corpus (docs/test-corpus.md). Fixture bytes are hydrated from the
# published, signed corpus into these paths and must never be committed: a
# fixture is added by ledgering and publishing it, not by `git add`. Only the
# generators, READMEs and text originals beside them are tracked.
/crates/unrar-rs/tests/fixtures/**/*.rar
/crates/unrar-rs/tests/fixtures/**/*.[r-z][0-9][0-9]
/crates/unrar-rs/tests/fixtures/**/*.rev
/crates/unrar-rs/tests/fixtures/**/*.exe
/crates/unrar-rs/tests/fixtures/**/*.bin
/crates/unrar-rs/tests/fixtures/**/*.mkv
/crates/unrar-rs/tests/fixtures/**/*.wav
/crates/par2-rs/tests/fixtures/**/*.rar
/crates/par2-rs/tests/fixtures/**/*.par2
/crates/par2-rs/tests/fixtures/par2cmdline-turbo/**/*.tar.gz
/crates/par2-rs/tests/fixtures/source/*.mkv
# Hydration scratch: `xtask test-corpus` writes through sibling temp files and
# renames them into place; a crash can leave one behind.
/crates/*/tests/fixtures/**/.*.tmp

# Local CI/release artifacts
/.ci/
/.ci-*.txt
/dist/
/package/
/logs/
/nasm.zip
/rarpar-*.tar.gz
/rarpar-*.zip
/SHA256SUMS

# Rust profiling/coverage
/coverage/
/tarpaulin-report.html
*.profraw
*.profdata

# Local environment/secrets
.env
.env.*
!.env.example

# macOS
.DS_Store
**/.DS_Store
._*

# Cargo-fuzz build state and generated crash artifacts.  Tracked corpus seeds
# live under each fuzz/corpus directory and are intentionally not ignored.
**/fuzz/target/
**/fuzz/artifacts/
**/fuzz/coverage/
**/fuzz/Cargo.lock
