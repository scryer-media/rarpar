diff --git a/src/platform/linux/filesearch.c b/src/platform/linux/filesearch.c
index 1b318ed..ce86034 100644
--- a/src/platform/linux/filesearch.c
+++ b/src/platform/linux/filesearch.c
@@ -165,9 +165,15 @@ static int findnext_impl(struct findstate *fs, struct _finddatai64_t *fileinfo)
     if (de->d_name[0] == '.') {
         fileinfo->attrib |= _A_HIDDEN;
     }
+#ifdef __APPLE__
+    fileinfo->time_create = st.st_ctimespec.tv_sec;
+    fileinfo->time_access = st.st_atimespec.tv_sec;
+    fileinfo->time_write  = st.st_mtimespec.tv_sec;
+#else
     fileinfo->time_create = st.st_ctim.tv_sec;
     fileinfo->time_access = st.st_atim.tv_sec;
     fileinfo->time_write  = st.st_mtim.tv_sec;
+#endif
     fileinfo->size        = st.st_size;
     return 0;
 }
